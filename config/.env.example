# Скопируйте этот файл в config/.env (локальный запуск) или в .env в корне проекта (Docker).
# Реальные ключи в репозиторий не добавляйте: оба файла внесены в .gitignore.

# Optional local LLM. The core screening pipeline works without Ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional API protection. Leave blank only for local demo use.
HEALTHSCREENING_API_KEY=

# Optional local storage path for anonymized confirmed cases.
# Для локального запуска значение по умолчанию (data/confirmed_cases.json) подходит;
# в Docker путь задан в docker-compose.yml (/app/runtime/confirmed_cases.json).
# LOCAL_CASES_PATH=runtime/confirmed_cases.json
